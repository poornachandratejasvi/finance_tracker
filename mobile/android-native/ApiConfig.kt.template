package com.poornachandratejasvi.financetracker

// Generated at CI build time from GitHub Actions secrets -- see
// .github/workflows/mobile-apk-debug.yml, which substitutes the placeholders below and
// writes the result to ApiConfig.kt (gitignored, never committed with real values). Same
// build-time-baked-secret approach as mobile/ios-native/APIConfig.swift.template.
//
// This is now only a FALLBACK: a compile-time-baked token can't be updated without a
// full rebuild, which turned out to be a real problem (a stale/rotated token failed
// silently, with no way for the user to see why). SmsReceiver.kt now prefers a
// runtime-refreshable credential stored via FinancetrackerNativeModule.kt's
// setSmsCredentials (set from Settings > SMS Auto-Detect, no rebuild needed), falling
// back to these compile-time values only if that hasn't been configured -- so an
// existing working setup doesn't break on upgrade.
object ApiConfig {
    const val SERVER_URL = "__FINANCE_SERVER_URL__"
    const val API_KEY = "__FINANCE_API_TOKEN__"
}
