{
  "expo": {
    "name": "Finance Tracker",
    "slug": "finance-tracker-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poornachandratejasvi.financetracker"
    },
    "android": {
      "package": "com.poornachandratejasvi.financetracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b6b4c"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withAppIntents",
      "./plugins/withSmsReceiver",
      "expo-sharing",
      "expo-sqlite",
      "expo-quick-actions",
      [
        "expo-image-picker",
        {
          "photosPermission": "Finance Tracker needs photo library access to attach a receipt image.",
          "cameraPermission": "Finance Tracker needs camera access to take a photo of a receipt."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finance Tracker uses Face ID to lock the app so your financial data stays private."
        }
      ]
    ]
  }
}
