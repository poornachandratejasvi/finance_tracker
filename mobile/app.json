{
  "expo": {
    "name": "Finance Tracker",
    "slug": "finance-tracker-mobile",
    "version": "1.1.10",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poornachandratejasvi.financetracker",
      "buildNumber": "1.1.10"
    },
    "android": {
      "package": "com.poornachandratejasvi.financetracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b6b4c"
      },
      "versionCode": 10
    },
    "plugins": [
      "./plugins/withAppIntents",
      "./plugins/withSmsReceiver",
      "expo-sharing",
      "expo-sqlite",
      "expo-quick-actions",
      [
        "expo-image-picker",
        {
          "photosPermission": "Finance Tracker needs photo library access to attach a receipt image.",
          "cameraPermission": "Finance Tracker needs camera access to take a photo of a receipt."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finance Tracker uses Face ID to lock the app so your financial data stays private."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1b6b4c"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Balance",
              "label": "Finance Tracker Balance",
              "description": "Your total balance and this month's spend, at a glance.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
