# Database Configuration
DATABASE_URL=postgresql://financeuser:financepass@db:5432/financedb
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=financepass
POSTGRES_DB=financedb

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Application Configuration
# Generate strong random values, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key used to encrypt sensitive data at rest (OAuth tokens, bank/PDF passwords).
# Leave blank to derive from SECRET_KEY. If set, keep it stable — changing it makes
# previously-encrypted values unreadable.
ENCRYPTION_KEY=

# Login brute-force protection
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Email Configuration
GMAIL_CREDENTIALS_PATH=/app/credentials/credentials.json
GMAIL_TOKEN_PATH=/app/credentials/token.json

# Application Settings
APP_NAME=Finance Tracker
APP_VERSION=1.0.0
DEBUG=False
# Origins allowed to call the backend. Must include the exact origin (scheme + host + port)
# your browser loads the frontend from. Defaults only cover same-machine localhost access —
# if you're accessing this from another machine, add that origin here, e.g.
# http://your-server-ip:3000 or http://your-domain:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend Configuration
# The URL your BROWSER uses to reach the backend — this gets baked into the frontend JS.
# "localhost" only works if your browser and the Docker host are the same machine. If you're
# accessing the app from a different machine (remote server, VM, etc.), set this to that
# server's actual reachable address, e.g. http://your-server-ip:8000 or http://your-domain:8000
REACT_APP_API_URL=http://localhost:8000

# Backend/Frontend URLs used to build Google OAuth redirect URLs (Gmail link, Drive backup,
# Google sign-in) and the post-login/callback redirect back to the app. Must match whatever
# address your browser actually loads the app from. Google requires HTTPS for OAuth redirects
# on any non-loopback address, so for a real domain these should be https:// URLs.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Only needed for docker-compose.traefik.yml (running behind an existing Traefik proxy) ---
# The hostname Traefik routes to this app, e.g. finance.yourdomain.com. Also set
# REACT_APP_API_URL/BACKEND_URL/FRONTEND_URL/ALLOWED_ORIGINS above to https://<this value>.
TRAEFIK_DOMAIN=
# Name of your existing external Traefik network, if not the common default "t2_proxy".
TRAEFIK_NETWORK=t2_proxy

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/app/uploads

# CSV Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True

# Concurrency
MAX_WORKERS=4

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Admin Account (First-time setup)
# Leave ADMIN_PASSWORD blank to auto-generate a secure password on first startup
# (printed once to the logs). To rotate later, set ADMIN_PASSWORD and ADMIN_RESET_PASSWORD=true.
ADMIN_EMAIL=admin@financetracker.com
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_RESET_PASSWORD=false

# Paperless-ngx (receipt archive -- the `paperless` service in BOTH
# docker-compose.traefik.yml and docker-compose.prod.yml). Bootstrap/deployment
# config only -- the finance app's own connection to Paperless (its URL + an API
# token, used to upload receipts) is configured live from Settings -> External
# Accounts, not here. Full setup instructions: docs/paperless-ngx.md
#
# Shared by both compose files:
PAPERLESS_DB_NAME=paperless
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_TIME_ZONE=Asia/Kolkata
PAPERLESS_OCR_LANGUAGE=eng
#
# docker-compose.traefik.yml only -- the subdomain Traefik routes to Paperless
# (needs its own DNS record pointing at this host, same as TRAEFIK_DOMAIN):
PAPERLESS_TRAEFIK_DOMAIN=paperless.yourdomain.com
#
# docker-compose.prod.yml only -- no Traefik, so Paperless is published directly
# on the host at this port (http://<host>:PAPERLESS_PORT). Override PAPERLESS_URL
# instead if you're putting your own reverse proxy in front of it.
PAPERLESS_PORT=8010
PAPERLESS_URL=
