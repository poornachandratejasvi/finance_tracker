# Database Configuration
DATABASE_URL=postgresql://financeuser:financepass@db:5432/financedb
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=financepass
POSTGRES_DB=financedb

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Application Configuration
# Generate strong random values, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key used to encrypt sensitive data at rest (OAuth tokens, bank/PDF passwords).
# Leave blank to derive from SECRET_KEY. If set, keep it stable — changing it makes
# previously-encrypted values unreadable.
ENCRYPTION_KEY=

# Login brute-force protection
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Email Configuration
GMAIL_CREDENTIALS_PATH=/app/credentials/credentials.json
GMAIL_TOKEN_PATH=/app/credentials/token.json

# Application Settings
APP_NAME=Finance Tracker
APP_VERSION=1.0.0
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/app/uploads

# CSV Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True

# Concurrency
MAX_WORKERS=4

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Admin Account (First-time setup)
# Leave ADMIN_PASSWORD blank to auto-generate a secure password on first startup
# (printed once to the logs). To rotate later, set ADMIN_PASSWORD and ADMIN_RESET_PASSWORD=true.
ADMIN_EMAIL=admin@financetracker.com
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_RESET_PASSWORD=false
